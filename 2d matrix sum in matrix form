#include<stdio.h>
int row,col,i,j;
int a[10][10],b[10][10],sum[10][10];
int main(void){
printf("please enter matrix size [row][col]:\n");
scanf("%d %d",&row,&col);
printf("please enter your 1 st matrix elements:\n");
for ( i = 0; i <row; i++)
{
   for ( j = 0; j < col; j++)
   {
    scanf("%d",&a[i][j]);
   } 
}
printf("please enter your 2nd matrix elements:\n");
for ( i = 0; i <row; i++)
{
   for ( j = 0; j < col; j++)
   {
    scanf("%d",&b[i][j]);
   }
}
for ( i = 0; i <row; i++)
{
   for ( j = 0; j < col; j++)
   {
    sum[i][j]=a[i][j]+b[i][j];
   }
   
}
printf("your matrix sum is :\n");
for ( i = 0; i <row; i++)
{
   for ( j = 0; j < col; j++)
   {
    printf("%d ",sum[i][j]);
   }
 printf("\n");  
}
}
