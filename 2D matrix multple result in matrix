#include<stdio.h>
int i,j,row,col;
int a[20][20],b[20][20],sum[20][20];
int main(void){
   printf("please enter matrix size [row][col]=\n");
   scanf("%d %d",&row,&col);
   printf("please enter your 1st matrix elements:\n");
   for ( i = 0; i < row; i++)
   {
     for ( j = 0; j < col; j++)
     {
      scanf("%d",&a[i][j]);
     }
     
   }
   printf("please enter your 2nd matrix elements:\n");
   for ( i = 0; i < row; i++)
   {
     for ( j = 0; j < col; j++)
     {
      scanf("%d",&b[i][j]);
     }
     
   }printf("your matrix multiple result is:\n");
   for ( i = 0; i < row; i++)
   {
     for ( j = 0; j < col; j++)
     {
      sum[i][j]=a[i][j]*b[i][j];
      printf("%d  ",sum[i][j]);
     }
    printf("\n"); 
   }

}
